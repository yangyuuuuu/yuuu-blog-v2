---
/** 深浅主题切换：状态存在 localStorage，首屏由 <head> 里的内联脚本提前应用 */
---

<button
  id="themeToggle"
  type="button"
  aria-label="切换深浅主题"
  title="切换深浅主题"
  class="grid h-10 w-10 place-items-center rounded-[11px] border border-line bg-surface
         text-base text-muted transition-colors hover:border-gold/60 hover:text-gold"
>
  <span id="themeIcon" aria-hidden="true">☾</span>
</button>

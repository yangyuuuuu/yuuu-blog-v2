---
/** 主题：深浅模式 + 皮肤。状态存 localStorage，首屏由 <head> 内联脚本提前应用。 */
const SKINS = [
  { id: 'fontaine', name: '枫丹', swatch: '#7ec8e3' },
  { id: 'opera', name: '歌剧院', swatch: '#e8a0b4' },
  { id: 'abyss', name: '深海', swatch: '#9b8ce8' },
];
---

<div class="relative" id="themeRoot">
  <button
    id="themeToggle"
    type="button"
    aria-label="主题与皮肤"
    aria-expanded="false"
    title="主题与皮肤"
    class="grid h-10 w-10 place-items-center rounded-[11px] border border-line bg-surface
           text-base text-muted transition-colors hover:border-gold/60 hover:text-gold"
  >
    <span id="themeIcon" aria-hidden="true">☾</span>
  </button>

  <div class="theme-menu" id="themeMenu" hidden>
    <p class="theme-menu-label">模式</p>
    <div class="theme-modes">
      <button type="button" data-mode="dark">深色</button>
      <button type="button" data-mode="light">浅色</button>
    </div>

    <p class="theme-menu-label">皮肤</p>
    <div class="theme-skins">
      {
        SKINS.map((s) => (
          <button type="button" data-skin={s.id}>
            <i style={`background:${s.swatch}`}></i>
            <span>{s.name}</span>
          </button>
        ))
      }
    </div>

    <p class="theme-menu-label">显示</p>
    <div class="theme-fx">
      <label><input type="checkbox" data-fx="reveal" /><span>文章进出动画</span></label>
      <label><input type="checkbox" data-fx="sink" /><span>首屏下沉动画</span></label>
      <label><input type="checkbox" data-fx="glass" /><span>卡片毛玻璃</span></label>
      <label><input type="checkbox" data-fx="scrollBlur" /><span>快速滑动模糊</span></label>
    </div>

    <p class="theme-menu-label">本地设置</p>
    <div class="theme-io">
      <button type="button" id="fxExport">导出</button>
      <button type="button" id="fxImport">导入</button>
      <input type="file" id="fxFile" accept="application/json" hidden />
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('themeRoot');
    var btn = document.getElementById('themeToggle');
    var menu = document.getElementById('themeMenu');
    var icon = document.getElementById('themeIcon');
    if (!root || !btn || !menu) return;

    var html = document.documentElement;
    var GLYPH = { dark: '☾', light: '☀' };
    var MODES = ['dark', 'light'];
    var SKINS = ['fontaine', 'opera', 'abyss'];

    function read(key, fallback) {
      try {
        var v = localStorage.getItem(key);
        return v || fallback;
      } catch (e) { return fallback; }
    }

    var FX = ['reveal', 'sink', 'glass', 'scrollBlur'];

    function readFx() {
      try { return JSON.parse(localStorage.getItem('yuuu-fx') || '{}'); } catch (e) { return {}; }
    }
    function writeFx(o) {
      try { localStorage.setItem('yuuu-fx', JSON.stringify(o)); } catch (e) {}
    }
    function applyFx(o) {
      FX.forEach(function (k) {
        html.classList.toggle('fx-' + k, o[k] !== false);
      });
    }

    function paint() {
      var m = read('yuuu-theme', 'dark');
      var s = read('yuuu-skin', 'fontaine');
      if (icon) icon.textContent = GLYPH[m] || GLYPH.dark;
      [].slice.call(menu.querySelectorAll('[data-mode]')).forEach(function (b) {
        b.classList.toggle('is-on', b.dataset.mode === m);
      });
      [].slice.call(menu.querySelectorAll('[data-skin]')).forEach(function (b) {
        b.classList.toggle('is-on', b.dataset.skin === s);
      });
      var fx = readFx();
      [].slice.call(menu.querySelectorAll('[data-fx]')).forEach(function (cb) {
        cb.checked = fx[cb.dataset.fx] !== false;
      });
    }

    /* 切换时开一个过渡开关，让颜色平滑变化，560ms 后撤掉（正好比过渡略长） */
    function swap(attr, value, key) {
      html.classList.add('theme-switching');
      html.setAttribute(attr, value);
      try { localStorage.setItem(key, value); } catch (e) {}
      window.setTimeout(function () { html.classList.remove('theme-switching'); }, 560);
      paint();
    }

    function close() {
      menu.hidden = true;
      btn.setAttribute('aria-expanded', 'false');
    }

    btn.addEventListener('click', function () {
      menu.hidden = !menu.hidden;
      btn.setAttribute('aria-expanded', menu.hidden ? 'false' : 'true');
    });

    menu.addEventListener('click', function (e) {
      var b = e.target && e.target.closest ? e.target.closest('button') : null;
      if (!b) return;
      if (b.dataset.mode && MODES.indexOf(b.dataset.mode) >= 0) swap('data-theme', b.dataset.mode, 'yuuu-theme');
      if (b.dataset.skin && SKINS.indexOf(b.dataset.skin) >= 0) swap('data-skin', b.dataset.skin, 'yuuu-skin');
    });

    /* 显示开关 */
    [].slice.call(menu.querySelectorAll('[data-fx]')).forEach(function (cb) {
      cb.addEventListener('change', function () {
        var fx = readFx();
        fx[cb.dataset.fx] = cb.checked;
        writeFx(fx);
        applyFx(fx);
      });
    });

    /* 导出：把主题 + 皮肤 + 显示设置写成一个 json 存到自己电脑 */
    var exportBtn = document.getElementById('fxExport');
    if (exportBtn) {
      exportBtn.addEventListener('click', function () {
        var data = {
          _about: 'yuuu 本地设置，可导入恢复',
          _exportedAt: new Date().toISOString(),
          theme: read('yuuu-theme', 'dark'),
          skin: read('yuuu-skin', 'fontaine'),
          fx: readFx(),
        };
        var blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
        var a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'yuuu-settings.json';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        setTimeout(function () { URL.revokeObjectURL(a.href); }, 1000);
      });
    }

    /* 导入 */
    var file = document.getElementById('fxFile');
    var importBtn = document.getElementById('fxImport');
    if (importBtn && file) {
      importBtn.addEventListener('click', function () { file.click(); });
      file.addEventListener('change', function () {
        var f = file.files && file.files[0];
        if (!f) return;
        var reader = new FileReader();
        reader.onload = function () {
          try {
            var d = JSON.parse(String(reader.result));
            html.classList.add('theme-switching');
            if (d.theme === 'light' || d.theme === 'dark') {
              html.setAttribute('data-theme', d.theme);
              localStorage.setItem('yuuu-theme', d.theme);
            }
            if (d.skin) {
              html.setAttribute('data-skin', d.skin);
              localStorage.setItem('yuuu-skin', d.skin);
            }
            if (d.fx && typeof d.fx === 'object') { writeFx(d.fx); applyFx(d.fx); }
            setTimeout(function () { html.classList.remove('theme-switching'); }, 560);
            paint();
          } catch (e) { /* 文件不是我们的格式，忽略 */ }
          file.value = '';
        };
        reader.readAsText(f);
      });
    }

    document.addEventListener('click', function (e) {
      if (!root.contains(e.target)) close();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') close();
    });

    paint();
  })();
</script>

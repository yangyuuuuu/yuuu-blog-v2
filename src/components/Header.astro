---
import SearchBox from './SearchBox.astro';
import ThemeToggle from './ThemeToggle.astro';
import SettingsPanel from './SettingsPanel.astro';

/* 顶部只留最常用的三项；归档 / 标签 / RSS 放在页脚，减少 hover 噪音 */
const NAV = [
  { href: '/', label: '首页' },
  { href: '/about/', label: '关于' },
  { href: '/changelog/', label: '更新' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header
  class="sticky top-0 z-60 border-b border-line backdrop-blur-xl backdrop-saturate-150 t-backdrop"
  style="background: var(--header-bg)"
>
  <div
    class="mx-auto flex w-full max-w-[1140px] flex-wrap items-center gap-x-3 gap-y-2.5 px-4 py-3
            lg:h-[68px] lg:flex-nowrap lg:gap-4 lg:px-5 lg:py-0 2xl:max-w-[1320px]"
  >
    <a href="/" class="flex shrink-0 items-center gap-3 text-ink">
      <span
        class="grid h-10 w-10 shrink-0 place-items-center rounded-xl border border-line-strong"
        style="background: var(--hover)"
      >
        <img
          src="/emblem.webp"
          alt=""
          width="256"
          height="256"
          class="h-[30px] w-[30px] object-contain"
          decoding="async"
        />
      </span>
      <span class="flex flex-col leading-none">
        <b class="font-title text-lg tracking-[0.14em]">yuuu</b>
        <i class="mt-0.5 text-[10px] not-italic tracking-[0.3em] text-muted">FONTAINE</i>
      </span>
    </a>

    <nav class="ml-auto hidden items-center gap-1 lg:flex 2xl:ml-6" id="mainNav" aria-label="主导航">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-full px-4 py-2 text-[14.5px] tracking-wide transition-colors',
              isActive(item.href)
                ? 'border border-line-strong bg-[var(--hover-strong)] font-semibold text-ink'
                : 'border border-transparent text-muted hover:bg-[var(--hover)] hover:text-ink',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- 手机上搜索独占第二行，桌面上收回导航栏右侧 -->
    <div class="relative order-last w-full lg:order-none lg:ml-2 lg:w-[240px] lg:shrink-0">
      <SearchBox />
    </div>

    <div class="ml-auto flex shrink-0 items-center gap-2 lg:ml-0">
      <ThemeToggle />
      <SettingsPanel />

      <button
        id="navToggle"
      type="button"
      aria-label="打开菜单"
      aria-expanded="false"
        class="grid h-10 w-10 shrink-0 place-items-center rounded-[11px] border border-line bg-surface
               text-muted transition-colors hover:border-gold/60 hover:text-gold lg:hidden"
      >☰</button>
    </div>
  </div>

  <nav id="mobileNav" hidden class="border-t border-line px-5 py-3 lg:hidden" aria-label="移动导航"
       style="background: var(--panel-2)">
    <div class="flex flex-col gap-1">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class:list={[
              'flex min-h-[44px] items-center rounded-xl px-4 text-[15px] transition-colors',
              isActive(item.href)
                ? 'bg-[var(--hover-strong)] font-semibold text-ink'
                : 'text-muted hover:bg-[var(--hover)] hover:text-ink',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('navToggle');
    var nav = document.getElementById('mobileNav');
    if (!btn || !nav) return;
    btn.addEventListener('click', function () {
      nav.hidden = !nav.hidden;
      btn.setAttribute('aria-expanded', nav.hidden ? 'false' : 'true');
    });
  })();
</script>

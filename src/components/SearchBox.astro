---
/** 站内搜索：Pagefind 静态索引，索引与模块都等用户聚焦输入框后才加载，不阻塞首屏 */
---

<div class="relative w-full" id="searchRoot">
  <label class="sr-only" for="yuuuSearch">搜索文章</label>
  <div class="search-box flex h-9 items-center gap-2 rounded-full border border-line bg-soft px-3 lg:h-11 lg:px-3.5">
    <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0" fill="none" stroke="currentColor"
         stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7" class="text-muted"></circle>
      <path d="M20 20l-3.6-3.6" class="text-muted"></path>
    </svg>
    <input
      id="yuuuSearch"
      type="search"
      placeholder="搜索文章…"
      autocomplete="off"
      class="search-input min-w-0 flex-1 bg-transparent text-sm text-ink outline-none placeholder:text-muted"
    />
    <!-- 快捷键提示做成独立徽标：放进 placeholder 会盖住输入光标 -->
    <kbd class="search-kbd" id="yuuuSearchKbd" aria-hidden="true">/</kbd>
    <button
      id="yuuuSearchClear"
      type="button"
      aria-label="清空搜索"
      hidden
      class="shrink-0 text-lg leading-none text-muted transition-colors hover:text-gold"
    >×</button>
  </div>

  <div class="search-panel fixed-layer" id="yuuuSearchPanel" hidden>
    <div id="yuuuSearchResults"></div>
  </div>
</div>

<script>
  /*
   * 引导：只负责「什么时候把搜索引擎拉下来」。
   * 引擎本体在 src/scripts/search-engine.ts —— Vite 会把它切成独立 chunk，
   * 首屏不下载，所以这段引导只有几百字节（见 HANDOFF.md「首屏 JS 预算」）。
   *
   * 分两段：
   *   1. 现在只装「键盘唤醒 + 加载占位」这一层，保证 Ctrl+K / "/" 第一次按就有反应；
   *   2. 用户一动手（聚焦 / 点搜索框 / 在里面按键）才把引擎拉下来，交它接管。
   * 引擎初始化要花一点时间，那之前敲进去的字由引擎 init() 里的补跑逻辑接住。
   */
  (function () {
    var root = document.getElementById('searchRoot');
    var input = document.getElementById('yuuuSearch');
    if (!root || !input) return;

    /* 收窄后固定成非空类型，闭包里不用再判空 */
    var field: HTMLInputElement = input as HTMLInputElement;
    var engine: Promise<void> | null = null;
    var failed = false;
    function boot() {
      if (engine || failed) return;
      engine = new Promise<{ init: () => void }>(function (resolve, reject) {
        import('../scripts/search-engine').then(resolve, reject);
      }).then(function (m) {
        m.init();
      }).catch(function () {
        // 离线或 chunk 404：说清楚就行，不要静默留个「正在准备搜索…」
        failed = true;
        engine = null;
        var panel = document.getElementById('yuuuSearchPanel');
        var out = document.getElementById('yuuuSearchResults');
        if (panel && out) {
          out.innerHTML = '<p class="search-empty">搜索引擎没能加载，检查一下网络再刷新页面。</p>';
          panel.hidden = false;
          panel.classList.add('is-interactive');
        }
      });
      return engine;
    }

    /* 引擎还没装好时，聚焦先把面板摆出来，别让人对着空屏等（引擎接管后自己会画） */
    root.addEventListener('focusin', function () {
      if (engine) return;
      var panel = document.getElementById('yuuuSearchPanel');
      var out = document.getElementById('yuuuSearchResults');
      if (panel && out && !out.innerHTML) {
        out.innerHTML = '<p class="search-empty">正在准备搜索…</p>';
        panel.hidden = false;
        panel.classList.add('is-interactive');
      }
    });
    root.addEventListener('pointerdown', boot);
    root.addEventListener('keydown', boot);

    /* 判断焦点是不是在可输入元素里 —— 在输入框里打「/」不该抢焦点 */
    function isTyping(el: any): boolean {
      if (!el || !el.tagName) return false;
      var tag = el.tagName;
      return tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || el.isContentEditable === true;
    }

    /*
     * Ctrl+K 与「/」现在是按需的，但第一次按下必须立刻有反应，
     * 所以快捷键本身由引导接管；引擎装好后它自己也监听，两边行为一致，不会打架。
     */
    document.addEventListener('keydown', function (e) {
      var combo = (e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K');
      var slash = e.key === '/' && !e.ctrlKey && !e.metaKey && !e.altKey && !isTyping(e.target);
      if (!combo && !slash) return;
      e.preventDefault();
      field.focus();
      field.select();
      boot();
    });
  })();
</script>

---
import { SITE } from '../../astro.config.mjs';

const year = new Date().getFullYear();
const LINKS = [
  { href: '/archive/', label: '归档' },
  { href: '/tags/', label: '标签' },
  { href: '/search-guide/', label: '搜索语法' },
  { href: '/changelog/', label: '更新历史' },
  { href: '/rss.xml', label: 'RSS' },
  { href: '/about/', label: '关于' },
  /*
   * 日记入口。站主要的是「知道网址才进得去」（1a），但也同意在页脚放一个
   * 不显眼的链接（1c），免得哪天忘了地址。密码照旧，链接本身不泄露任何内容。
   * 不想要的话删掉这一行即可，页面本身还在 /diary/。
   */
  { href: '/diary/', label: '日记' },
];
---

<footer class="relative z-1 mt-10 border-t border-line pt-14 pb-12 text-center" style="background: var(--footer-bg)">
  <div class="mx-auto w-full max-w-[1140px] px-5">
    <div class="no-select mx-auto mb-3.5 h-11 w-11 opacity-85">
      <img src="/emblem.webp" alt="" width="256" height="256" class="h-full w-full object-contain" loading="lazy" decoding="async" />
    </div>

    <p class="no-select mb-2 font-title tracking-[0.1em] text-ink">yuuu</p>
    <p class="mb-3 text-[13px] text-muted">
      Astro + Tailwind + Pagefind · 部署在 Cloudflare Pages
    </p>

    <p class="mb-3 flex flex-wrap justify-center gap-2.5 text-[13px]">
      {
        LINKS.map((l, i) => (
          <>
            {i > 0 && <span class="text-line-strong">·</span>}
            <a href={l.href} class="text-muted transition-colors hover:text-gold">{l.label}</a>
          </>
        ))
      }
    </p>

    <p class="no-select text-xs text-muted/75">
      © {year} yuuu · 个人学习与非商业用途，与原游戏官方无关
    </p>
  </div>
</footer>

---
/**
 * 设置面板。
 * 面板内部逻辑放在 src/scripts/settings-panel.ts，首次点开才动态加载，
 * 这样首屏不用为「可能不会被打开的面板」付出 JS 体积。
 */
/* 卡片风格，和 settings-panel.ts 里的 CARD_STYLES 对应 */
const CARD_STYLES = [
  { id: 'glass', name: '毛玻璃', desc: '默认样式' },
  { id: 'line', name: '极简线', desc: '没有底色，只有细线' },
  { id: 'paper', name: '纸张', desc: '浅底厚圆角' },
  { id: 'float', name: '悬浮', desc: '无边框强阴影' },
];

const SKINS = [
  { id: 'fontaine', name: '枫丹', swatch: '#7ec8e3' },
  { id: 'opera', name: '歌剧院', swatch: '#e8a0b4' },
  { id: 'abyss', name: '深海', swatch: '#9b8ce8' },
];
---

<div class="relative" id="settingsRoot">
  <button
    id="settingsToggle"
    type="button"
    aria-label="设置"
    aria-expanded="false"
    title="设置"
    class="grid h-9 w-9 shrink-0 place-items-center rounded-[11px] border border-line bg-surface
           text-[15px] text-muted transition-colors hover:border-gold/60 hover:text-gold lg:h-10 lg:w-10"
  >⚙</button>

  <div class="theme-menu" id="settingsMenu" hidden>
    <p class="theme-menu-label">配色</p>
    <div class="theme-skins">
      {
        SKINS.map((s) => (
          <button type="button" data-skin={s.id}>
            <i style={`background:${s.swatch}`}></i>
            <span>{s.name}</span>
          </button>
        ))
      }
    </div>

    <p class="theme-menu-label">主页列数</p>
    <div class="theme-cols">
      {[2, 3, 4, 5, 6].map((n) => <button type="button" data-cols={n}>{n}</button>)}
    </div>

    <!--
      卡片风格：只换卡片的呈现方式，配色 / 列数 / 动画都不受影响。
      「毛玻璃」就是建站以来的默认样式，保留在第一位。
    -->
    <p class="theme-menu-label">卡片风格</p>
    <div class="theme-styles" id="cardStyles">
      {CARD_STYLES.map((s) => (
        <button type="button" data-card={s.id} title={s.desc}>
          <i class={'cs-preview cs-' + s.id} aria-hidden="true"></i>
          <span>{s.name}</span>
        </button>
      ))}
    </div>

    <p class="theme-menu-label">显示</p>
    <div class="theme-fx">
      <label><input type="checkbox" data-fx="reveal" /><span>文章进出动画</span></label>
      <label><input type="checkbox" data-fx="sink" /><span>首屏下沉动画</span></label>
      <label><input type="checkbox" data-fx="glass" /><span>卡片毛玻璃</span></label>
      <label><input type="checkbox" data-fx="scrollBlur" /><span>快速滑动模糊</span></label>
    </div>

    <p class="theme-menu-label">本地设置</p>
    <div class="theme-io">
      <button type="button" id="fxExport">导出</button>
      <button type="button" id="fxImport">导入</button>
      <input type="file" id="fxFile" accept="application/json" hidden />
    </div>
  </div>
</div>

<script>
  /*
   * 引导：只负责开合面板，并在首次点击时把真正的逻辑拉下来。
   * 面板逻辑见 src/scripts/settings-panel.ts —— Vite 会把它切成独立 chunk，
   * 首屏不下载，所以这段引导只有几百字节。
   */
  (function () {
    var btn = document.getElementById('settingsToggle');
    var menu = document.getElementById('settingsMenu');
    if (!btn || !menu) return;

    var loaded = false;
    btn.addEventListener('click', function () {
      menu.hidden = !menu.hidden;
      btn.setAttribute('aria-expanded', menu.hidden ? 'false' : 'true');
      if (!loaded) {
        loaded = true;
        import('../scripts/settings-panel').then(function (m) { m.init(); });
      }
    });
  })();
</script>

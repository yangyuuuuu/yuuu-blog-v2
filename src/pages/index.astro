---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import TagCloud from '../components/TagCloud.astro';
import { getPosts, collectTags, collectCategories, PAGE_SIZE } from '../lib/posts';

const posts = await getPosts();
const tags = collectTags(posts);
const categories = collectCategories(posts);
const firstPage = posts.slice(0, PAGE_SIZE);
const hasMore = posts.length > PAGE_SIZE;
---

<BaseLayout>
  <!-- 首屏：只有徽记和两个词，占满一屏，看不到下面的文章 -->
  <section class="hero no-select" id="top">
    <div class="hero-inner" id="heroInner">
      <img
        src="/emblem.webp"
        alt=""
        width="256"
        height="256"
        class="hero-emblem"
        fetchpriority="high"
        decoding="async"
      />

      <p class="hero-kicker">FONTAINE · FURINA</p>
      <p class="hero-name">yuuu</p>
      <p class="hero-meta">{posts.length} 篇 · {tags.length} 标签 · {categories.length} 分类</p>

      <a href="#latest" class="hero-scroll" aria-label="下滑查看文章">
        <span>下滑</span>
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 5v13M6 13l6 6 6-6"></path>
        </svg>
      </a>
    </div>
  </section>

  <!-- 以下内容初始下沉 + 模糊，滚进视口后浮上来 -->
  <div class="sink" id="sink">
  <section class="mx-auto w-full max-w-[1140px] px-5 pb-24 2xl:max-w-[1320px]" id="latest">
    <header class="mb-6 flex flex-wrap items-end justify-between gap-3">
      <div>
        <p class="text-[11px] tracking-[0.42em] text-accent uppercase">LATEST</p>
        <h2 class="mt-1.5 font-title text-[27px] tracking-wide">
          最新手记 <span class="ml-2 text-[12.5px] font-normal text-muted" id="resultCount">共 {posts.length} 篇</span>
        </h2>
      </div>
      <a href="/archive/" class="text-[13.5px] tracking-wide text-muted transition-colors hover:text-gold">全部归档 →</a>
    </header>

    <div
      class="relative z-30 flex flex-wrap items-center gap-2.5 rounded-card border border-line bg-surface p-4 backdrop-blur-md t-surface t-backdrop"
    >
      <span class="text-xs tracking-[0.2em] text-muted">分类</span>
      <button
        type="button"
        data-cat=""
        class="cat-chip rounded-full border border-accent bg-[var(--hover-strong)] px-4 py-2 text-[13.5px] font-semibold text-ink"
      >全部</button>
      {
        categories.map(({ category, count }) => (
          <button
            type="button"
            data-cat={category}
            class="cat-chip rounded-full border border-line px-4 py-2 text-[13.5px] text-muted transition-colors hover:border-line-strong hover:bg-[var(--hover)] hover:text-ink"
          >{category} <i class="not-italic opacity-55">{count}</i></button>
        ))
      }
    </div>

    <div class="mt-4 mb-6">
      <TagCloud tags={tags} />
    </div>

    <div class="grid gap-6" id="postGrid">
      {firstPage.map((post) => <PostCard post={post} />)}
    </div>

    <p class="hidden py-16 text-center text-[15px] text-muted" id="emptyState">没有符合条件的文章。</p>

    <div class="mt-10 text-center">
      <button
        id="loadMore"
        type="button"
        data-next={hasMore ? 2 : 0}
        hidden={!hasMore}
        class="rounded-full border border-line-strong bg-surface px-7 py-3 text-[14.5px] text-ink backdrop-blur transition-colors hover:border-gold/60 hover:text-gold"
      >加载更多</button>
      <p class="mt-3 text-xs text-muted" id="loadHint">
        {hasMore ? `已显示最近 ${firstPage.length} 篇` : '已经到底啦'}
      </p>
    </div>
  </section>
  </div>

  <script>
    /* 下滑时首屏整体缩小 + 淡出，文章版块顺势接上来。只动 transform / opacity */
    (function () {
      var hero = document.getElementById('top');
      var inner = document.getElementById('heroInner');
      if (!hero || !inner) return;
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      var raf = 0;
      function update() {
        raf = 0;
        var h = hero.offsetHeight || window.innerHeight;
        var p = Math.min(1, Math.max(0, window.scrollY / (h * 0.8)));
        var e = 1 - Math.pow(1 - p, 2);            // easeOutQuad，起步快收尾稳
        inner.style.transform =
          'translate3d(0,' + (-e * 30).toFixed(1) + 'px,0) scale(' + (1 - e * 0.2).toFixed(4) + ')';
        inner.style.opacity = Math.max(0, 1 - e * 1.15).toFixed(3);
      }
      window.addEventListener('scroll', function () { if (!raf) raf = requestAnimationFrame(update); }, { passive: true });
      window.addEventListener('resize', update);
      update();
    })();

    /* 第二屏内容进入视口时浮现一次；之后各卡片再由 .reveal 逐个淡入 */
    (function () {
      var sink = document.getElementById('sink');
      if (!sink) return;
      var done = false;
      function show() {
        if (done) return;
        done = true;
        sink.classList.add('is-in');
        sink.addEventListener('transitionend', function () {
          sink.classList.add('is-done');   // 摘掉 filter 层
        }, { once: true });
      }
      // 直接带着 #latest 打开时，不要等观察器
      if (location.hash === '#latest' || !('IntersectionObserver' in window)) { show(); }
      else {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { show(); io.disconnect(); }
          });
        }, { rootMargin: '0px 0px -10% 0px', threshold: 0.01 });
        io.observe(sink);
      }
    })();

    (function () {
      var grid = document.getElementById('postGrid');
      var btn = document.getElementById('loadMore');
      var hint = document.getElementById('loadHint');
      var empty = document.getElementById('emptyState');
      var countEl = document.getElementById('resultCount');
      var chips = [].slice.call(document.querySelectorAll('.cat-chip'));
      if (!grid) return;

      var next = btn ? Number(btn.dataset.next || 0) : 0;
      var busy = false;
      var filter = '';
      var loadedAll = !next;

      /* 新追加的卡片交给全局观察器，由它决定何时淡入 */
      function revealNew(nodes) {
        if (window.__yuuuReveal) { window.__yuuuReveal(nodes); return; }
        requestAnimationFrame(function () {
          nodes.forEach(function (el) { el.classList.add('is-in'); });
        });
      }

      function applyFilter() {
        var cards = [].slice.call(grid.children);
        var shown = 0;
        cards.forEach(function (el) {
          var ok = !filter || el.dataset.category === filter;
          el.hidden = !ok;
          if (ok) shown++;
        });
        if (empty) empty.hidden = shown !== 0;
        if (countEl) {
          countEl.textContent = filter ? `${shown} 篇 · ${filter}` : `共 ${cards.length} 篇`;
        }
        if (hint) {
          hint.textContent = loadedAll ? (filter ? '筛选完成' : '已经到底啦') : '还有更多，点右侧按钮继续加载';
        }
      }

      async function loadAll() {
        while (next) {
          var res = await fetch('/api/posts/' + next + '.json').then(function (r) { return r.json(); });
          var box = document.createElement('div');
          box.innerHTML = res.html;
          var nodes = [].slice.call(box.children);
          nodes.forEach(function (el) { grid.appendChild(el); });
          revealNew(nodes);
          next = res.next || 0;
        }
        loadedAll = true;
        if (btn) btn.hidden = true;
      }

      chips.forEach(function (chip) {
        chip.addEventListener('click', function () {
          filter = chip.dataset.cat || '';
          chips.forEach(function (c) {
            var on = c === chip;
            c.classList.toggle('bg-[var(--hover-strong)]', on);
            c.classList.toggle('border-accent', on);
            c.classList.toggle('font-semibold', on);
            c.classList.toggle('text-ink', on);
            c.classList.toggle('text-muted', !on);
          });
          if (filter && !loadedAll) { loadAll().then(applyFilter); } else { applyFilter(); }
        });
      });

      if (btn) {
        btn.addEventListener('click', function () {
          if (busy || !next) return;
          busy = true;
          var label = btn.textContent;
          btn.textContent = '加载中…';
          fetch('/api/posts/' + next + '.json')
            .then(function (r) { return r.json(); })
            .then(function (res) {
              var box = document.createElement('div');
              box.innerHTML = res.html;
              var nodes = [].slice.call(box.children);
              nodes.forEach(function (el) { grid.appendChild(el); });
              revealNew(nodes);
              next = res.next || 0;
              btn.dataset.next = next;
              if (!next) { btn.hidden = true; loadedAll = true; }
              if (hint) hint.textContent = loadedAll ? '已经到底啦' : '已显示最近 ' + grid.children.length + ' 篇';
              btn.textContent = label;
              busy = false;
              applyFilter();
            })
            .catch(function () {
              btn.textContent = '加载失败，点击重试';
              busy = false;
            });
        });
      }
    })();
  </script>
</BaseLayout>

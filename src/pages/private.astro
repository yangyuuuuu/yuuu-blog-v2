---
/**
 * 隐藏文章入口 —— yuuu.love/private/
 *
 * 定位：这些文章本来通过具体 URL 就能访问，口令只是挡住「顺手翻到的人」。
 * 不做内容加密，只做三件事：不给口令不显示清单、摘要默认盖住、每次访问留日志。
 *
 * 页面静态 HTML 里不含任何隐藏文章的标题或链接 —— 只在服务端响应里。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SortSelect from '../components/SortSelect.astro';
---

<BaseLayout title="私人角落" description="需要口令" noindex>
  <div class="pv-wrap">
    <section class="pv-card" id="pvLogin">
      <p class="pv-kicker">PRIVATE</p>
      <h1 class="pv-title">私人角落</h1>
      <p class="pv-desc">这里放的是不想被翻到的文章。输入口令即可进入。</p>
      <form id="pvForm" autocomplete="off">
        <input id="pvPwd" type="password" placeholder="口令" autocomplete="current-password" aria-label="口令" />
        <button type="submit" id="pvGo">进入</button>
      </form>
      <p class="pv-msg" id="pvMsg" role="status" aria-live="polite"></p>
    </section>

    <section class="pv-card" id="pvList" hidden>
      <p class="pv-kicker">UNLOCKED</p>
      <h1 class="pv-title">私人角落</h1>

      <div class="pv-controls">
        <input id="pvSearch" type="search" placeholder="搜索标题 / 摘要 / 正文 / 标签…" autocomplete="off" aria-label="搜索私人文章" />
        <SortSelect id="pvSort" size="md" label="" />
      </div>
      <p class="pv-count" id="pvCount"></p>

      <ul class="pv-list" id="pvItems"></ul>
      <p class="pv-empty" id="pvEmpty" hidden>没搜到。</p>

      <p class="pv-note">
        点标题打开文章（新标签页，回来还在这一页）；点「展开摘要」看摘要。
        本页每次访问都会记录：时刻、IP、设备、停留时长。
      </p>
      <button type="button" class="pv-again" id="pvAgain">换口令 / 离开</button>
    </section>
  </div>

  <style>
    * { box-sizing: border-box; }
    .pv-wrap {
      max-width: 700px; margin: 0 auto; padding: 54px 20px 90px;
      font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Hiragino Sans GB", sans-serif;
    }
    .pv-card {
      border: 1px solid var(--line, rgba(126,200,227,.2));
      background: var(--surface, rgba(255,255,255,.04));
      border-radius: 20px; padding: 30px;
    }
    .pv-kicker { margin: 0 0 10px; font-size: 11px; letter-spacing: .34em; color: var(--accent, #7ec8e3); }
    .pv-title { margin: 0 0 18px; font-size: clamp(23px, 3.2vw, 31px); color: var(--ink, #e0f0ff); font-weight: 600; letter-spacing: .01em; }
    .pv-desc { margin: 0 0 18px; font-size: 14px; line-height: 1.85; color: var(--ink-2, #b3cde3); }

    #pvForm { display: flex; gap: 10px; flex-wrap: wrap; }
    .pv-controls { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 14px; }
    #pvPwd, #pvSearch {
      height: 44px; padding: 0 14px; border-radius: 12px;
      border: 1px solid var(--line, rgba(126,200,227,.25));
      background: var(--bg-soft, rgba(255,255,255,.05));
      color: var(--ink, #e0f0ff); font-size: 14.5px; outline: none;
      -webkit-appearance: none; appearance: none;
    }
    #pvPwd, #pvSearch { flex: 1 1 220px; min-width: 0; }

    #pvPwd:focus, #pvSearch:focus {
      border-color: var(--accent, #7ec8e3);
      box-shadow: 0 0 0 3px rgba(126,200,227,.2);
    }
    #pvGo {
      height: 44px; padding: 0 24px; border: 0; border-radius: 12px;
      background: var(--accent, #7ec8e3); color: #0d1b2a;
      font-size: 15px; font-weight: 600; cursor: pointer;
    }
    #pvGo[disabled] { opacity: .55; cursor: default; }
    .pv-msg { margin: 14px 0 0; min-height: 20px; font-size: 13px; color: var(--gold, #e8c87a); }
    .pv-msg.is-error { color: #ff9a9a; }
    .pv-count { margin: 0 0 16px; font-size: 12.5px; color: var(--muted, #7997b3); }
    .pv-empty { margin: 14px 0 0; font-size: 13.5px; color: var(--muted, #7997b3); }

    /* 卡片列表：和站点首页的手记卡片同一套语言 */
    .pv-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
    .pv-item {
      position: relative;
      padding: 18px 20px;
      border: 1px solid var(--line, rgba(126,200,227,.18));
      border-radius: 16px;
      background: var(--panel, rgba(255,255,255,.03));
      transition: border-color .2s, transform .2s, box-shadow .2s;
    }
    .pv-item:hover {
      border-color: var(--accent, #7ec8e3);
      transform: translateY(-1px);
      box-shadow: var(--shadow-soft, 0 10px 26px -18px rgba(27,58,92,.34));
    }
    /* 标题：和主站卡片标题同一套衬线字体（--font-title），字号也放大一档 */
    .pv-link {
      display: block;
      font-family: var(--font-title, 'Songti SC', 'STSong', Georgia, serif);
      font-size: 21px; font-weight: 600; color: var(--ink, #e0f0ff);
      text-decoration: none; letter-spacing: .02em; line-height: 1.45;
      word-break: break-word;
      transition: color .2s;
    }
    .pv-link:hover { color: var(--accent, #7ec8e3); }
    /* 时间 / 分类：紧贴标题下方，小一号并压暗 */
    .pv-date {
      display: block; margin-top: 7px;
      font-size: 11.5px; letter-spacing: .07em;
      color: var(--muted, #7997b3); opacity: .78;
    }
    .pv-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
    .pv-tag {
      font-size: 11px; padding: 2px 8px; border-radius: 999px;
      background: var(--hover, rgba(126,200,227,.08));
      color: var(--accent, #7ec8e3);
    }
    .pv-x {
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
      overflow: hidden; font-size: 13px; line-height: 1.8; color: var(--ink-2, #b3cde3);
    }
    .pv-x.is-expanded { -webkit-line-clamp: unset; }
    .pv-mask {
      margin: 8px 0 0; padding: 0; border: 0; background: none; cursor: pointer;
      font-size: 12px; color: var(--gold, #e8c87a); text-align: left;
    }
    .pv-mask:hover { text-decoration: underline; }
    /* 盖住时摘要打码：能看出「有内容」，但读不出字 */
    .pv-x.is-masked { filter: blur(6px); user-select: none; pointer-events: none; }

    .pv-note { margin: 24px 0 0; font-size: 12px; line-height: 1.85; color: var(--muted, #7997b3); }
    .pv-again {
      margin-top: 16px; padding: 9px 16px; border-radius: 11px; cursor: pointer;
      border: 1px solid var(--line, rgba(126,200,227,.25));
      background: transparent; color: var(--ink-2, #b3cde3); font-size: 13px;
    }
    .pv-again:hover { border-color: var(--gold, #e8c87a); color: var(--gold, #e8c87a); }

    @media (max-width: 560px) {
      .pv-wrap { padding: 28px 14px 64px; }
      .pv-card { padding: 22px 17px; border-radius: 16px; }
      .pv-controls { flex-direction: column; }
      .pv-item { padding: 15px 16px; }
      .pv-link { font-size: 16px; }
      .pv-top { flex-direction: column; gap: 6px; }
    }
  </style>

  <script>
    const API = 'https://oauth.yuuu.love';
    const KEY = 'yuuu-private';
    const login = document.getElementById('pvLogin');
    const listBox = document.getElementById('pvList');
    const form = document.getElementById('pvForm');
    const pwd = document.getElementById('pvPwd');
    const go = document.getElementById('pvGo');
    const msg = document.getElementById('pvMsg');
    const itemsEl = document.getElementById('pvItems');
    const emptyEl = document.getElementById('pvEmpty');
    const countEl = document.getElementById('pvCount');
    const searchEl = document.getElementById('pvSearch');
    const sortEl = document.getElementById('pvSort');          // 隐藏的 <select>，只存值
    const again = document.getElementById('pvAgain');

    let all = [];        // 服务端返回的全部条目
    let ticket = null;
    let enteredAt = 0;

    const flush = () => {
      if (!ticket) return;
      const secs = Math.round((Date.now() - enteredAt) / 1000);
      try { navigator.sendBeacon(API + '/hidden/leave', JSON.stringify({ ticket, seconds: secs })); } catch (e) {}
      ticket = null;
    };
    window.addEventListener('pagehide', flush);
    document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'hidden') flush(); });

    const say = (t, isErr) => { msg.textContent = t || ''; msg.classList.toggle('is-error', !!isErr); };

    /* 口令+清单存 sessionStorage：返回/刷新不用重输；关标签页即失效 */
    const saveSession = (pass, posts) => { try { sessionStorage.setItem(KEY, JSON.stringify({ pass, posts })); } catch (e) {} };
    const readSession = () => { try { return JSON.parse(sessionStorage.getItem(KEY) || 'null'); } catch (e) { return null; } };
    const clearSession = () => { try { sessionStorage.removeItem(KEY); } catch (e) {} };

    function enter(posts) {
      all = posts || [];
      login.hidden = true;
      listBox.hidden = false;
      say('');
      if (searchEl) searchEl.value = '';
      if (sortEl) sortEl.value = 'date-desc';
      render();
    }

    async function verify(pass, from) {
      const res = await fetch(API + '/hidden', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password: pass, from: from || 'direct' }),
      });
      if (res.status === 429) {
        const j = await res.json().catch(() => ({}));
        throw new Error(j.message || '试得太频繁，等一会儿再来');
      }
      if (!res.ok) throw new Error('口令不对');
      const data = await res.json();
      ticket = data.ticket || null;
      enteredAt = Date.now();
      saveSession(pass, data.posts || []);
      return data.posts || [];
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const pass = pwd.value;
      if (!pass) { say('先输口令', true); return; }
      go.disabled = true;
      say('正在校验…');
      try {
        const posts = await verify(pass, new URLSearchParams(location.search).get('from'));
        pwd.value = '';
        enter(posts);
      } catch (err) {
        say(err.message || '校验失败', true);
        if (err.message === '口令不对') pwd.select();
      } finally {
        go.disabled = false;
      }
    });

    if (searchEl) searchEl.addEventListener('input', render);

    /*
     * 排序：SortSelect 组件负责画下拉、把选中值写回隐藏 <select> 并派发 change，
     * 真正重排列表得在这里接住那个 change。
     */
    if (sortEl) sortEl.addEventListener('change', render);


    /*
     * 排序。
     *  - 发布：用 date
     *  - 最近修改：用 updated（没写就退回 date）。updated 只到「天」，
     *    所以同一天被改过的几篇还要用 touches（改过它的提交数）再分先后 ——
     *    否则一天里改了几篇，这里排出来会和「最新发布」完全一样，
     *    切换排序看起来就像没反应（这个坑踩过一次）。
     *
     * 与 src/lib/sort-posts.ts 是同一套规则（那份给 node 侧的检查用）。
     * 这里是 is:inline 脚本，不能 import —— 改规则时两边一起改；
     * npm run audit 会拿真实清单跑共享模块，两边不一致会当场红。
     */
    function sortPosts(list, mode) {
      const d = (p) => p.date || '';
      const u = (p) => p.updated || p.date || '';
      const t = (p) => p.touches || 0;
      const arr = list.slice();
      if (mode === 'date-asc') arr.sort((a, b) => d(a).localeCompare(d(b)));
      else if (mode === 'updated-desc') {
        arr.sort((a, b) => u(b).localeCompare(u(a)) || t(b) - t(a) || d(b).localeCompare(d(a)));
      } else arr.sort((a, b) => d(b).localeCompare(d(a)));
      return arr;
    }

    function render() {
      const q = (searchEl ? searchEl.value : '').trim().toLowerCase();
      /* 全文搜索：标题 / 摘要 / 正文 / 标签 / 分类 / 日期 */
      const matched = !q
        ? all.slice()
        : all.filter((p) =>
            [p.title, p.summary, p.text, (p.tags || []).join(' '), p.category, p.date]
              .some((v) => String(v || '').toLowerCase().includes(q)),
          );
      const shown = sortPosts(matched, sortEl ? sortEl.value : 'date-desc');

      const total = all.length;
      countEl.textContent = shown.length === total
        ? '共 ' + total + ' 篇'
        : '匹配 ' + shown.length + ' / ' + total + ' 篇';
      emptyEl.hidden = shown.length !== 0;
      itemsEl.innerHTML = '';

      for (const p of shown) {
        const li = document.createElement('li');
        li.className = 'pv-item';

        const a = document.createElement('a');
        a.className = 'pv-link';
        a.href = p.url;
        a.target = '_blank';
        a.rel = 'noopener';
        a.textContent = p.title || p.url;

        const date = document.createElement('span');
        date.className = 'pv-date';
        date.textContent = (p.date || '') + (p.category ? ' · ' + p.category : '');

        li.append(a, date);

        if (p.tags && p.tags.length) {
          const tags = document.createElement('div');
          tags.className = 'pv-tags';
          for (const t of p.tags) {
            const s = document.createElement('span');
            s.className = 'pv-tag';
            s.textContent = t;
            tags.appendChild(s);
          }
          li.appendChild(tags);
        }

        /* 不在列表里展开摘要了（用户反馈显示效果差）：只有标题 + 日期/分类 + 标签，
           想看内容就点标题进文章。要临时瞄一眼摘要可以按住卡片看 title 提示。 */
        li.title = p.summary || '';
        itemsEl.appendChild(li);
      }
    }

    again.addEventListener('click', () => {
      flush();
      clearSession();
      listBox.hidden = true;
      login.hidden = false;
      all = [];
      itemsEl.innerHTML = '';
      say('');
      pwd.value = '';
      pwd.focus();
    });

    /* 刷新/返回时用会话里的口令自动重新校验（会经过服务端，所以也记一条日志） */
    (async function restore() {
      const s = readSession();
      if (!s || !s.pass) return;
      try { enter(await verify(s.pass, 'restore')); }
      catch (e) { clearSession(); }
    })();

    pwd.focus();
  </script>
</BaseLayout>
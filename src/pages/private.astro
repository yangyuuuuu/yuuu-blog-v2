---
/**
 * 隐藏文章入口 —— yuuu.love/private/
 *
 * 定位（说清楚，免得误以为是保险箱）：
 *   这些文章本来通过具体 URL 就能访问，口令只是挡住「顺手翻到的人」。
 *   所以本页不做内容加密，只做三件事：
 *     1. 不给口令就不显示清单（清单由 Worker 口令校验后代取）
 *     2. 每条只露标题和日期，摘要默认盖住；点标题直接去文章，点「摘要」展开
 *     3. 每次访问 / 尝试都在服务端留日志
 *
 * 页面静态 HTML 里不含任何隐藏文章的标题或链接 —— 只在服务端响应里。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="私人角落" description="需要口令" noindex>
  <div class="pv-wrap">
    <section class="pv-card" id="pvLogin">
      <p class="pv-kicker">PRIVATE</p>
      <h1 class="pv-title">私人角落</h1>
      <p class="pv-desc">这里放的是不想被翻到的文章。输入口令即可进入。</p>
      <form id="pvForm" autocomplete="off">
        <input id="pvPwd" type="password" placeholder="口令" autocomplete="current-password" aria-label="口令" />
        <button type="submit" id="pvGo">进入</button>
      </form>
      <p class="pv-msg" id="pvMsg" role="status" aria-live="polite"></p>
    </section>

    <section class="pv-card" id="pvList" hidden>
      <p class="pv-kicker">UNLOCKED</p>
      <h1 class="pv-title">私人角落</h1>
      <div class="pv-bar">
        <input id="pvSearch" type="search" placeholder="在这个角落里搜…（标题 / 摘要 / 分类）" autocomplete="off" aria-label="搜索私人文章" />
        <button type="button" class="pv-ghost" id="pvHideAll">全部收起</button>
      </div>
      <p class="pv-desc" id="pvCount"></p>
      <ul class="pv-items" id="pvItems"></ul>
      <p class="pv-empty" id="pvEmpty" hidden>没搜到。</p>
      <p class="pv-note">
        点标题直接打开文章（新标签页，回来还在这一页）；
        点标题右边的「摘要」展开摘要，再点收起。
        本页每次访问都会记录：时刻、IP、设备、停留时长。
      </p>
      <button type="button" class="pv-again" id="pvAgain">换口令 / 离开</button>
    </section>
  </div>

  <style>
    * { box-sizing: border-box; }
    .pv-wrap {
      max-width: 720px; margin: 0 auto; padding: 52px 20px 84px;
      font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Hiragino Sans GB", sans-serif;
    }
    .pv-card {
      border: 1px solid var(--line, rgba(126,200,227,.2));
      background: var(--surface, rgba(255,255,255,.04));
      border-radius: 18px; padding: 28px;
    }
    .pv-kicker { margin: 0 0 10px; font-size: 11px; letter-spacing: .34em; color: var(--accent, #7ec8e3); }
    .pv-title { margin: 0 0 14px; font-size: clamp(22px, 3.2vw, 30px); color: var(--ink, #e0f0ff); font-weight: 600; }
    .pv-desc { margin: 0 0 18px; font-size: 14px; line-height: 1.8; color: var(--ink-2, #b3cde3); }

    #pvForm, .pv-bar { display: flex; gap: 10px; flex-wrap: wrap; }
    .pv-bar { margin-bottom: 14px; }
    #pvPwd, #pvSearch {
      flex: 1 1 200px; min-width: 0; width: 100%; height: 44px; padding: 0 14px;
      border-radius: 11px;
      border: 1px solid var(--line, rgba(126,200,227,.25));
      background: var(--bg-soft, rgba(255,255,255,.05));
      color: var(--ink, #e0f0ff); font-size: 15px; outline: none;
      /* 手机上 search 类型自带圆角/内边距，统一掉 */
      -webkit-appearance: none; appearance: none;
    }
    #pvPwd:focus, #pvSearch:focus { border-color: var(--accent, #7ec8e3); box-shadow: 0 0 0 3px rgba(126,200,227,.2); }
    #pvGo {
      height: 44px; padding: 0 22px; border: 0; border-radius: 11px;
      background: var(--accent, #7ec8e3); color: #0d1b2a; font-size: 15px; font-weight: 600; cursor: pointer;
    }
    #pvGo[disabled] { opacity: .55; cursor: default; }
    .pv-ghost {
      height: 44px; padding: 0 16px; border-radius: 11px; cursor: pointer;
      border: 1px solid var(--line, rgba(126,200,227,.25));
      background: transparent; color: var(--ink-2, #b3cde3); font-size: 13px;
    }
    .pv-ghost:hover { border-color: var(--gold, #e8c87a); color: var(--gold, #e8c87a); }
    .pv-msg { margin: 14px 0 0; min-height: 20px; font-size: 13px; color: var(--gold, #e8c87a); }
    .pv-msg.is-error { color: #ff9a9a; }
    .pv-empty { margin: 14px 0 0; font-size: 13.5px; color: var(--muted, #7997b3); }

    .pv-items { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
    .pv-item {
      border: 1px solid var(--line, rgba(126,200,227,.18));
      border-radius: 13px; padding: 13px 15px;
    }
    .pv-item:hover { border-color: var(--accent, #7ec8e3); background: var(--hover, rgba(126,200,227,.06)); }
    .pv-row { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
    .pv-link {
      font-size: 15px; font-weight: 600; color: var(--ink, #e0f0ff);
      text-decoration: none; min-width: 0; word-break: break-word;
    }
    .pv-link:hover { color: var(--accent, #7ec8e3); }
    .pv-meta { display: flex; align-items: baseline; gap: 10px; flex-shrink: 0; }
    .pv-date { font-size: 11.5px; color: var(--muted, #7997b3); white-space: nowrap; }
    .pv-toggle {
      border: 1px solid var(--line, rgba(126,200,227,.25)); border-radius: 8px;
      background: transparent; color: var(--ink-2, #b3cde3);
      font-size: 11.5px; padding: 3px 8px; cursor: pointer; white-space: nowrap;
    }
    .pv-toggle:hover { border-color: var(--gold, #e8c87a); color: var(--gold, #e8c87a); }
    .pv-x {
      display: block; margin-top: 9px; font-size: 12.5px; line-height: 1.75;
      color: var(--ink-2, #b3cde3);
    }
    .pv-x[hidden] { display: none; }
    /* 摘要收起时打码，既知道有内容、又不至于一眼看全 */
    .pv-x.is-masked { filter: blur(6px); user-select: none; pointer-events: none; }

    .pv-note { margin: 22px 0 0; font-size: 12px; line-height: 1.8; color: var(--muted, #7997b3); }
    .pv-again {
      margin-top: 16px; padding: 9px 16px; border-radius: 10px; cursor: pointer;
      border: 1px solid var(--line, rgba(126,200,227,.25));
      background: transparent; color: var(--ink-2, #b3cde3); font-size: 13px;
    }
    .pv-again:hover { border-color: var(--gold, #e8c87a); color: var(--gold, #e8c87a); }

    @media (max-width: 520px) {
      .pv-wrap { padding: 30px 14px 64px; }
      .pv-card { padding: 20px 16px; }
      .pv-bar { flex-direction: column; }
      .pv-bar button { width: 100%; }
      /* 结果行在窄屏改成上下两行，避免标题把日期/按钮挤出屏幕 */
      .pv-row { flex-direction: column; align-items: stretch; gap: 6px; }
      .pv-meta { justify-content: space-between; }
    }
  </style>

  <script>
    /*
     * 口令校验在 Worker 上（服务端）：密码不在这页里、能限流、每次尝试都留日志。
     * 清单也只存在于服务端响应里 —— 页面 HTML 里没有任何隐藏文章的信息。
     */
    const API = 'https://oauth.yuuu.love';
    const KEY = 'yuuu-private';           // sessionStorage：这样「返回」不用重新输口令
    const login = document.getElementById('pvLogin');
    const listBox = document.getElementById('pvList');
    const form = document.getElementById('pvForm');
    const pwd = document.getElementById('pvPwd');
    const go = document.getElementById('pvGo');
    const msg = document.getElementById('pvMsg');
    const itemsEl = document.getElementById('pvItems');
    const emptyEl = document.getElementById('pvEmpty');
    const countEl = document.getElementById('pvCount');
    const searchEl = document.getElementById('pvSearch');
    const hideAllBtn = document.getElementById('pvHideAll');
    const again = document.getElementById('pvAgain');

    let all = [];
    let shown = [];
    let ticket = null;
    let enteredAt = 0;

    const flush = () => {
      if (!ticket) return;
      const secs = Math.round((Date.now() - enteredAt) / 1000);
      try { navigator.sendBeacon(API + '/hidden/leave', JSON.stringify({ ticket, seconds: secs })); } catch (e) {}
      ticket = null;
    };
    window.addEventListener('pagehide', flush);
    document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'hidden') flush(); });

    const say = (t, isErr) => { msg.textContent = t || ''; msg.classList.toggle('is-error', !!isErr); };

    /* 把「口令 + 清单」缓存在 sessionStorage：同一标签页内返回/刷新都不用重输。
       关掉标签页就没了；而且只存会话，不落盘。 */
    function saveSession(pass, posts) {
      try { sessionStorage.setItem(KEY, JSON.stringify({ pass, posts })); } catch (e) {}
    }
    function readSession() {
      try { return JSON.parse(sessionStorage.getItem(KEY) || 'null'); } catch (e) { return null; }
    }
    function clearSession() {
      try { sessionStorage.removeItem(KEY); } catch (e) {}
    }

    function enter(posts) {
      all = posts || [];
      login.hidden = true;
      listBox.hidden = false;
      say('');
      if (searchEl) searchEl.value = '';
      filter('');
    }

    async function verify(pass, from) {
      const res = await fetch(API + '/hidden', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password: pass, from: from || 'direct' }),
      });
      if (res.status === 429) {
        const j = await res.json().catch(() => ({}));
        throw new Error(j.message || '试得太频繁，等一会儿再来');
      }
      if (!res.ok) throw new Error('口令不对');
      const data = await res.json();
      ticket = data.ticket || null;
      enteredAt = Date.now();
      saveSession(pass, data.posts || []);
      return data.posts || [];
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const pass = pwd.value;
      if (!pass) { say('先输口令', true); return; }
      go.disabled = true;
      say('正在校验…');
      try {
        const posts = await verify(pass, new URLSearchParams(location.search).get('from'));
        pwd.value = '';
        enter(posts);
      } catch (err) {
        say(err.message || '校验失败', true);
        if (err.message === '口令不对') pwd.select();
      } finally {
        go.disabled = false;
      }
    });

    if (searchEl) searchEl.addEventListener('input', () => filter(searchEl.value));

    function filter(kw) {
      const q = (kw || '').trim().toLowerCase();
      shown = !q
        ? all.slice()
        : all.filter((p) =>
            [p.title, p.summary, p.category, p.date, (p.tags || []).join(' ')]
              .some((v) => String(v || '').toLowerCase().includes(q)),
            /* tags 是数组，join 后一起匹配 */
          );
      render();
    }

    function render() {
      const total = all.length;
      countEl.textContent = shown.length === total
        ? '共 ' + total + ' 篇。点标题直接打开文章；点「摘要」展开摘要。'
        : '匹配 ' + shown.length + ' / ' + total + ' 篇。';
      emptyEl.hidden = shown.length !== 0;
      itemsEl.innerHTML = '';
      for (const p of shown) {
        const li = document.createElement('li');
        li.className = 'pv-item';

        const row = document.createElement('div');
        row.className = 'pv-row';

        const a = document.createElement('a');
        a.className = 'pv-link';
        a.href = p.url;
        a.target = '_blank';       // 新标签打开：返回时本页还在，不用重输口令
        a.rel = 'noopener';
        a.textContent = p.title || p.url;

        const meta = document.createElement('div');
        meta.className = 'pv-meta';
        const d = document.createElement('span');
        d.className = 'pv-date';
        d.textContent = (p.category ? p.category + ' · ' : '') + (p.date || '');
        const t = document.createElement('button');
        t.type = 'button';
        t.className = 'pv-toggle';
        t.textContent = '摘要';
        meta.append(d, t);

        row.append(a, meta);

        const x = document.createElement('span');
        x.className = 'pv-x is-masked';
        x.textContent = p.summary || '（这篇没写摘要）';
        x.hidden = true;

        t.addEventListener('click', () => {
          const open = !x.hidden;
          x.hidden = open;
          x.classList.toggle('is-masked', open);
          t.textContent = open ? '摘要' : '收起';
        });

        li.append(row, x);
        itemsEl.appendChild(li);
      }
    }

    if (hideAllBtn) hideAllBtn.addEventListener('click', () => {
      itemsEl.querySelectorAll('.pv-item').forEach((li) => {
        const x = li.querySelector('.pv-x');
        const t = li.querySelector('.pv-toggle');
        if (x) { x.hidden = true; x.classList.add('is-masked'); }
        if (t) t.textContent = '摘要';
      });
    });

    again.addEventListener('click', () => {
      flush();
      clearSession();
      listBox.hidden = true;
      login.hidden = false;
      all = []; shown = [];
      itemsEl.innerHTML = '';
      say('');
      pwd.value = '';
      pwd.focus();
    });

    /* 刷新/返回时用会话里的口令重新校验一次（校验要通过服务端，所以每次都会记日志） */
    (async function restore() {
      const s = readSession();
      if (!s || !s.pass) return;
      try {
        const posts = await verify(s.pass, 'restore');
        enter(posts);
      } catch (e) {
        clearSession();   // 口令改了或过期了，就让用户重新输
      }
    })();

    pwd.focus();
  </script>
</BaseLayout>

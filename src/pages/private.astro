---
/**
 * 隐藏文章入口 —— yuuu.love/private/
 *
 * 定位（说清楚，免得误以为是保险箱）：
 *   这些文章本来通过具体 URL 就能访问，密码只是挡住「顺手翻到的人」。
 *   所以本页**不做加密**，只做两件事：
 *     1. 不给密码就不显示清单（清单由 Worker 密码校验后代取）
 *     2. 每次访问/尝试都在服务端留一条日志（IP、设备、时刻、停留时长）
 *
 * 页面自己的 HTML 里**不含任何隐藏文章的标题或链接** —— 那些只存在于
 * Worker 的响应里。所以「查看源代码」什么也看不到。
 */
import BaseLayout from '../layouts/BaseLayout.astro';

---

<BaseLayout title="私人角落" description="需要密码" noindex>
  <div class="pv-wrap">
    <section class="pv-card" id="pvLogin">
      <p class="pv-kicker">PRIVATE</p>
      <h1 class="pv-title">私人角落</h1>
      <p class="pv-desc">这里放的是不想被翻到的文章。输入口令即可进入。</p>
      <form id="pvForm" autocomplete="off">
        <input
          id="pvPwd"
          type="password"
          inputmode="text"
          placeholder="口令"
          autocomplete="current-password"
          aria-label="口令"
        />
        <button type="submit" id="pvGo">进入</button>
      </form>
      <p class="pv-msg" id="pvMsg" role="status" aria-live="polite"></p>
    </section>

    <section class="pv-card" id="pvList" hidden>
      <p class="pv-kicker">UNLOCKED</p>
      <h1 class="pv-title">私人角落</h1>
      <p class="pv-desc" id="pvCount"></p>
      <ul class="pv-items" id="pvItems"></ul>
      <p class="pv-note">
        内容首次展开会先模糊一下（防肩窥），碰一下或按 Esc 收起。
        本页每次访问都会记录：时刻、IP、设备、停留时长。
      </p>
      <button type="button" class="pv-again" id="pvAgain">换口令 / 离开</button>
    </section>
  </div>

  <style>
    .pv-wrap {
      max-width: 720px; margin: 0 auto; padding: 52px 20px 84px;
      font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Hiragino Sans GB", sans-serif;
    }
    .pv-card {
      border: 1px solid var(--line, rgba(126,200,227,.2));
      background: var(--surface, rgba(255,255,255,.04));
      border-radius: 18px;
      padding: 28px;
    }
    .pv-kicker { margin: 0 0 10px; font-size: 11px; letter-spacing: .34em; color: var(--accent, #7ec8e3); }
    .pv-title { margin: 0 0 10px; font-size: clamp(22px, 3.2vw, 30px); color: var(--ink, #e0f0ff); font-weight: 600; }
    .pv-desc { margin: 0 0 22px; font-size: 14px; line-height: 1.8; color: var(--ink-2, #b3cde3); }
    #pvForm { display: flex; gap: 10px; flex-wrap: wrap; }
    #pvPwd {
      flex: 1 1 200px; min-width: 0;
      height: 44px; padding: 0 14px;
      border-radius: 11px;
      border: 1px solid var(--line, rgba(126,200,227,.25));
      background: var(--bg-soft, rgba(255,255,255,.05));
      color: var(--ink, #e0f0ff);
      font-size: 15px;
      outline: none;
    }
    #pvPwd:focus { border-color: var(--accent, #7ec8e3); box-shadow: 0 0 0 3px rgba(126,200,227,.2); }
    #pvGo {
      height: 44px; padding: 0 22px;
      border: 0; border-radius: 11px;
      background: var(--accent, #7ec8e3);
      color: #0d1b2a; font-size: 15px; font-weight: 600;
      cursor: pointer;
    }
    #pvGo:hover { filter: brightness(1.06); }
    #pvGo[disabled] { opacity: .55; cursor: default; }
    .pv-msg { margin: 14px 0 0; min-height: 20px; font-size: 13px; color: var(--gold, #e8c87a); }
    .pv-msg.is-error { color: #ff9a9a; }

    .pv-items { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
    .pv-item {
      display: block; padding: 14px 16px;
      border: 1px solid var(--line, rgba(126,200,227,.18));
      border-radius: 13px;
      text-decoration: none;
      transition: border-color .18s, background .18s;
    }
    .pv-item:hover { border-color: var(--accent, #7ec8e3); background: var(--hover, rgba(126,200,227,.07)); }
    .pv-item-top { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
    .pv-item-top b { font-size: 15px; color: var(--ink, #e0f0ff); font-weight: 600; }
    .pv-item-top i { font-style: normal; font-size: 11.5px; color: var(--muted, #7f9ab0); flex-shrink: 0; }
    .pv-item-x { display: block; margin-top: 5px; font-size: 12.5px; line-height: 1.7; color: var(--ink-2, #b3cde3); }

    .pv-blur { filter: blur(9px); transition: filter .28s ease; cursor: pointer; }
    .pv-blur.is-open { filter: none; cursor: auto; }
    .pv-note { margin: 22px 0 0; font-size: 12px; line-height: 1.8; color: var(--muted, #7f9ab0); }
    .pv-again {
      margin-top: 16px; padding: 9px 16px;
      border: 1px solid var(--line, rgba(126,200,227,.25));
      border-radius: 10px; background: transparent;
      color: var(--ink-2, #b3cde3); font-size: 13px; cursor: pointer;
    }
    .pv-again:hover { border-color: var(--gold, #e8c87a); color: var(--gold, #e8c87a); }
  </style>

  <script>
    /*
     * 口令校验在 Worker 上做（服务端），所以：
     *   · 密码不在这页里，扒源码看不到
     *   · 能限流（试太多次会被锁）
     *   · 每次尝试都在服务端留日志
     * 页面静态 HTML 里也没有任何隐藏文章的信息 —— 清单是服务端返回的。
     */
    const API = 'https://oauth.yuuu.love';
    const login = document.getElementById('pvLogin');
    const listBox = document.getElementById('pvList');
    const form = document.getElementById('pvForm');
    const pwd = document.getElementById('pvPwd');
    const go = document.getElementById('pvGo');
    const msg = document.getElementById('pvMsg');
    const items = document.getElementById('pvItems');
    const countEl = document.getElementById('pvCount');
    const again = document.getElementById('pvAgain');

    /* 停留时长：离开/切后台时用 sendBeacon 补报一次，服务端会补写进那条日志。
       浏览器被强杀时可能报不上，属于可接受误差。 */
    let ticket = null;
    let enteredAt = 0;
    const flush = () => {
      if (!ticket) return;
      const secs = Math.round((Date.now() - enteredAt) / 1000);
      try {
        navigator.sendBeacon(API + '/hidden/leave', JSON.stringify({ ticket, seconds: secs }));
      } catch (e) { /* 上报失败无所谓 */ }
      ticket = null;
    };
    window.addEventListener('pagehide', flush);
    document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'hidden') flush(); });

    const say = (text, isError) => {
      msg.textContent = text || '';
      msg.classList.toggle('is-error', !!isError);
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const pass = pwd.value;
      if (!pass) { say('先输口令', true); return; }
      go.disabled = true;
      say('正在校验…');
      try {
        const res = await fetch(API + '/hidden', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password: pass, from: new URLSearchParams(location.search).get('from') || 'direct' }),
        });
        if (res.status === 429) {
          const j = await res.json().catch(() => ({}));
          say(j.message || '试得太频繁，等一会儿再来', true);
          return;
        }
        if (!res.ok) { say('口令不对', true); pwd.select(); return; }

        const data = await res.json();
        ticket = data.ticket || null;
        enteredAt = Date.now();
        render(data.posts || []);
        say('');
        login.hidden = true;
        listBox.hidden = false;
        pwd.value = '';
      } catch (err) {
        say('连不上服务器，检查网络后重试', true);
      } finally {
        go.disabled = false;
      }
    });

    function render(posts) {
      countEl.textContent = posts.length ? '共 ' + posts.length + ' 篇 —— 点开即读，注意别被旁边的人看到。' : '还没有隐藏的文章。';
      items.innerHTML = '';
      for (const p of posts) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.className = 'pv-item';
        a.href = p.url;
        const d = p.date ? ' · ' + p.date : '';
        a.innerHTML =
          '<span class="pv-item-top"><b></b><i></i></span><span class="pv-item-x"></span>';
        a.querySelector('b').textContent = p.title;
        a.querySelector('i').textContent = (p.category || '') + d;
        a.querySelector('.pv-item-x').textContent = p.summary || '';
        li.appendChild(a);
        items.appendChild(li);
      }
    }

    /* 防肩窥：清单整体先模糊，碰一下（或 Esc）才展开 */
    listBox.addEventListener('mouseenter', () => listBox.classList.add('pv-blur'), { once: true });
    document.addEventListener('click', () => items.classList.add('is-open'));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') items.classList.remove('is-open'); });

    again.addEventListener('click', () => {
      flush();
      listBox.hidden = true;
      login.hidden = false;
      items.classList.remove('is-open');
      say('');
      pwd.focus();
    });

    pwd.focus();
  </script>
</BaseLayout>

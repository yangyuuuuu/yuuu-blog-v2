---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts, groupByYear } from '../lib/posts';
import { formatShort } from '../lib/format';

const posts = await getPosts();
const years = groupByYear(posts);

const CAT_CLASS: Record<string, string> = {
  日记: 'bg-gold',
  技术: 'bg-accent',
  随笔: 'bg-[#c9a0ff]',
};
---

<BaseLayout title="归档" description="按年份浏览全部文章">
  <section class="mx-auto w-full max-w-[1140px] px-5 pt-14 pb-8">
    <p class="text-[11px] tracking-[0.42em] text-accent uppercase">ARCHIVE</p>
    <h1 class="mt-2.5 mb-3 font-title text-[clamp(26px,4.2vw,42px)] tracking-wide text-ink">文章归档</h1>
    <p class="text-ink-2">按时间倒序排列，目前共收录 <b class="text-gold">{posts.length}</b> 篇。</p>
  </section>

  <section class="mx-auto w-full max-w-[1140px] px-5 pb-24">
    {
      years.map(({ year, posts: list }) => (
        <section class="mb-11">
          <h2 class="mb-4 flex items-center gap-4 font-title text-2xl tracking-[0.12em] text-gold">
            {year}
            <em class="text-[13px] not-italic tracking-normal text-muted">{list.length} 篇</em>
            <span class="h-px flex-1 bg-gradient-to-r from-[var(--line-strong)] to-transparent" />
          </h2>

          <div class="flex flex-col gap-2">
            {list.map((p) => (
              <a
                href={`/posts/${p.id}/`}
                class="flex flex-wrap items-center gap-x-4 gap-y-2 rounded-soft border border-transparent px-4 py-3.5 transition-colors hover:translate-x-1.5 hover:border-line hover:bg-surface"
              >
                <span class={`h-2 w-2 shrink-0 rounded-full ${CAT_CLASS[p.data.category] ?? 'bg-accent'}`} />
                <time datetime={formatShort(p.data.date)} class="shrink-0 font-mono text-[13px] text-muted">
                  {formatShort(p.data.date)}
                </time>
                <span class="flex-1 text-[15.5px] text-ink-2">{p.data.title}</span>
                <span class="shrink-0 text-xs text-muted/70">{p.data.category}</span>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </section>
</BaseLayout>

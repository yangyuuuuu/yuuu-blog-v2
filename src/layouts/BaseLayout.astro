---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Background from '../components/Background.astro';
import { SITE_TITLE, SITE_DESC, CF_BEACON_TOKEN } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  crest?: boolean;
}

const {
  title,
  description = SITE_DESC,
  image = '/og-default.png',
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
  crest = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE_TITLE}` : `${SITE_TITLE} · 在枫丹的午后写点什么`;
const site = import.meta.env.SITE ?? 'https://yuuu.pages.dev';
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0d1b2a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5faff" media="(prefers-color-scheme: light)" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta name="twitter:card" content="summary_large_image" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

    <!--
      首屏主题 / 皮肤 / 特效 / 列数：必须在首次绘制前定好，否则会闪一下默认样式。

      ⚠️ 这些说明故意写在 <script> **外面**。
      这是 is:inline 脚本，里面的中文注释一个汉字占 3 字节，
      会直接吃掉 PRD 那条「首屏行内 JS < 10KB」的红线（实测：注释搬出来省了 1.2KB）。
      以后改这里的代码也请保持精简，别把说明搬回脚本里。

      · 明暗：localStorage['yuuu-theme'] = auto | light | dark，默认 auto。
        auto 按小时判断，白天区间取 localStorage['yuuu-day']（默认 "7-19"，
        支持跨夜如 "20-6"）。函数挂在 window.__yuuuTheme 上 ——
        设置面板和顶栏按钮都调它，省得三处各写一份判断。
      · auto 模式下每分钟对一次表、切回标签页时也对一次，页面一直开着也能到点自动切。
      · 皮肤：localStorage['yuuu-skin'] 同样要在绘制前应用，否则会闪默认配色。
      · js 标记：首屏「下沉」和卡片「滚动进出」的初始态只在有 JS 时才生效 ——
        这样脚本挂了内容也不会永远隐身（旧版踩过这个坑）。
      · 显示设置默认全开；只有加了 fx-* 类才有对应效果，
        所以「脚本挂了」= 效果关闭 + 内容可见，是安全的失败方向。
      · 主页列数在首屏前设好，避免从 3 列跳变。
    -->
    <script is:inline>
      (function () {
        var de = document.documentElement;
        window.__yuuuTheme = function () {
          var t = localStorage.getItem('yuuu-theme') || 'auto';
          if (t === 'light' || t === 'dark') { de.setAttribute('data-theme', t); return; }
          var a = 7, b = 19;
          try {
            var p = String(localStorage.getItem('yuuu-day') || '7-19').split('-');
            var x = +p[0], y = +p[1];
            if (x >= 0 && x <= 23) a = x;
            if (y >= 0 && y <= 23) b = y;
          } catch (e) {}
          var h = new Date().getHours();
          de.setAttribute('data-theme', (a <= b ? h >= a && h < b : h >= a || h < b) ? 'light' : 'dark');
        };
        window.__yuuuTheme();
        try {
          var s = localStorage.getItem('yuuu-skin');
          if (s === 'opera' || s === 'abyss' || s === 'fontaine') de.setAttribute('data-skin', s);
        } catch (e) {}
        de.classList.add('js');
        var fx = JSON.parse(localStorage.getItem('yuuu-fx') || '{}');
        if (fx.reveal !== false) de.classList.add('fx-reveal');
        if (fx.sink !== false) de.classList.add('fx-sink');
        if (fx.glass !== false) de.classList.add('fx-glass');
        if (fx.scrollBlur !== false) de.classList.add('fx-scrollblur');
        var cols = +localStorage.getItem('yuuu-cols') || 3;
        if (cols >= 2 && cols <= 6) de.style.setProperty('--home-cols', String(cols));
        setInterval(window.__yuuuTheme, 60000);
        document.addEventListener('visibilitychange', function () {
          if (!document.hidden) window.__yuuuTheme();
        });
      })();
    </script>
  </head>

  <body class="min-h-screen">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-100 focus:rounded-lg focus:bg-surface-2 focus:px-4 focus:py-2 focus:text-ink"
    >跳到正文</a>

    <Background crest={crest} />

    <!--
      搜索聚光遮罩。⚠️ pointer-events: none 是硬性要求 ——
      全屏 fixed 层一旦能接收事件，整站按钮就全点不动了（旧版踩过这个坑）。
      z-index 50：在正文之上、顶栏（z-70）之下；顶栏用不透明底，所以不会透出暗幕。
    -->
    <div class="search-veil" id="searchVeil" aria-hidden="true"></div>

    <div class="relative z-10 flex min-h-screen flex-col">
      <Header />
      <main id="main" class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>

    <script is:inline>
      /*
       * 进出视口都做动画：进屏幕淡入上浮，出屏幕原路退回。
       * 观察器挂在 window 上，「加载更多」追加的卡片可以继续 observe。
       */
      (function () {
        function showAll() {
          [].slice.call(document.querySelectorAll('.reveal')).forEach(function (el) {
            el.classList.add('is-in');
          });
        }
        if (!('IntersectionObserver' in window)) { showAll(); return; }

        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            en.target.classList.toggle('is-in', en.isIntersecting);
          });
        }, { rootMargin: '0px 0px -7% 0px', threshold: 0.06 });

        window.__yuuuIO = io;
        window.__yuuuReveal = function (nodes) {
          [].slice.call(nodes).forEach(function (el) { io.observe(el); });
        };
        window.__yuuuReveal(document.querySelectorAll('.reveal'));
      })();

      /* 快速滑动时的动态模糊：按滚动速度开合一个类 */
      (function () {
        var de = document.documentElement;
        if (!de.classList.contains('fx-scrollblur')) return;
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        var lastY = window.scrollY, lastT = performance.now(), raf = 0, off = 0;
        function sample() {
          raf = 0;
          var now = performance.now();
          var v = Math.abs(window.scrollY - lastY) / Math.max(8, now - lastT); // px/ms
          lastY = window.scrollY;
          lastT = now;
          if (v > 1.6) {
            de.classList.add('is-fast');
            clearTimeout(off);
            off = setTimeout(function () { de.classList.remove('is-fast'); }, 130);
          }
        }
        window.addEventListener('scroll', function () {
          if (!raf) raf = requestAnimationFrame(sample);
        }, { passive: true });
      })();
    </script>

    {
      CF_BEACON_TOKEN && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: CF_BEACON_TOKEN })}
        />
      )
    }
  </body>
</html>

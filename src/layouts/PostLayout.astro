---
import BaseLayout from './BaseLayout.astro';
import CoverStyle from '../components/CoverStyle.astro';
import { formatDate, formatISO } from '../lib/format';
import {
  coverStyleOf, coverHueOf, coverLetterOf, coverSrcOf, readingOf, wordsOf, neighbours, urlOf, isHidden,
  type Post,
} from '../lib/posts';

interface Props {
  post: Post;
  all: Post[];
  headings?: { depth: number; slug: string; text: string }[];
}
const { post, all, headings = [] } = Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const d = post.data;
const { newer, older } = neighbours(all, post);
/* 隐藏的文章：去掉 data-pagefind-body（Pagefind 就不会索引它），并让搜索引擎别收录。
   分享卡片也换成中性摘要 —— 免得链接被贴到别处时，摘要跟着露出去。 */
const hidden = isHidden(post);
const description = hidden ? 'yuuu 的一篇私人记录' : d.summary ?? d.title;
---

<BaseLayout
  title={d.title}
  description={description}
  type="article"
  publishedTime={d.date}
  modifiedTime={d.updated}
  noindex={hidden}
>
  <div class="progress-bar" id="progressBar" aria-hidden="true"></div>

  <div class="article-wrap relative mx-auto w-full px-5 pt-12 pb-10" id="articleWrap">
    <!-- 右边缘拖拽手柄：拖动改正文宽度，双击复位 -->
    <button
      class="article-resizer"
      id="articleResizer"
      type="button"
      aria-label="拖动调整正文宽度，双击复位"
      title="拖动调整正文宽度（双击复位）"
    ></button>

    <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-[minmax(0,1fr)_242px]">
    <!-- data-pagefind-body：告诉 Pagefind 只索引正文，别把导航栏/页脚/标签页也算进去。
         隐藏的文章不加这个属性 —— 直接访问能看，但搜不到。 -->
    <article
      data-pagefind-body={hidden ? undefined : true}
      class="t-surface t-backdrop min-w-0 rounded-card border border-line bg-surface p-6 backdrop-blur-md shadow-[var(--shadow)] sm:p-8 lg:p-11"
    >
      <header class="mb-6 border-b border-line pb-6">
        <span class="mb-3 inline-block text-[11.5px] tracking-[0.34em] text-accent uppercase">
          {d.category}
        </span>
        <h1 class="mb-4 font-title text-[clamp(24px,3.4vw,37px)] leading-tight text-ink">{d.title}</h1>

        <!--
          给 Pagefind 索引塞的元数据。放在 sr-only 里：
          视觉上不显示，但构建时 Pagefind 解析 HTML 能读到，
          搜索结果就能按分类 / 标签 / 字数 / 阅读时长 / 日期做筛选与区间比较。
        -->
        <div class="sr-only" aria-hidden="true">
          <span data-pagefind-filter="category" data-pagefind-meta="category">{d.category}</span>
          {d.tags.map((t) => <span data-pagefind-filter="tag">{t}</span>)}
          <span data-pagefind-meta="tags">{d.tags.join(' ')}</span>
          <span data-pagefind-meta="words">{wordsOf(post)}</span>
          <span data-pagefind-meta="minutes">{readingOf(post)}</span>
          <span data-pagefind-meta="date">{formatISO(d.date)}</span>
        </div>

        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-[13px] text-muted">
          <span>📅 创建 <time data-pagefind-meta="dateText" datetime={formatISO(d.date)}>{formatDate(d.date)}</time></span>
          {
            d.updated && (
              <>
                <span class="opacity-40">·</span>
                <span>✏️ 修改 <time datetime={formatISO(d.updated)}>{formatDate(d.updated)}</time></span>
              </>
            )
          }
          <span class="opacity-40">·</span>
          <span>☕ 约 {readingOf(post)} 分钟</span>
          <span class="opacity-40">·</span>
          <span>✍ {wordsOf(post)} 字</span>
        </div>

        {
          d.tags.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-2">
              {d.tags.map((t) => (
                <a
                  href={`/tags/${encodeURIComponent(t)}/`}
                  class="rounded-full border border-dashed border-line px-3 py-1 text-xs text-muted transition-colors hover:border-line-strong hover:bg-[var(--hover)] hover:text-accent"
                >#{t}</a>
              ))}
            </div>
          )
        }
      </header>

      <CoverStyle
        style={coverStyleOf(post)}
        hue={coverHueOf(post)}
        letter={coverLetterOf(post)}
        image={coverSrcOf(post)}
        alt={d.title}
        class="mb-7 h-[190px] rounded-soft border border-line sm:h-[260px]"
      />

      <div class="prose-yuuu" id="postBody">
        <slot />
      </div>

      <div data-pagefind-ignore class="mt-8 flex flex-wrap items-center gap-3 border-t border-dashed border-line pt-5">
        <button
          id="copyLink"
          type="button"
          class="rounded-full border border-line bg-surface px-4 py-2 text-[13px] text-muted transition-colors hover:border-gold/60 hover:text-gold"
        >复制本文链接</button>
        <a
          href={`/tags/${encodeURIComponent(d.category)}/`}
          class="rounded-full border border-line px-4 py-2 text-[13px] text-muted transition-colors hover:border-accent hover:text-accent"
        >更多「{d.category}」</a>
      </div>
    </article>

    <aside class="lg:sticky lg:top-[92px]" id="toc">
      <div class="t-surface t-backdrop rounded-card border border-line bg-surface p-5 backdrop-blur-md shadow-[var(--shadow-soft)]">
        <p class="mb-3 text-[11px] tracking-[0.36em] text-accent uppercase">目录</p>
        <nav id="tocNav" class="flex flex-col">
          {
            toc.map((h) => (
              <a
                href={`#${h.slug}`}
                class:list={[
                  'border-l-2 border-transparent py-1.5 text-[13.4px] leading-snug text-muted transition-colors hover:bg-[var(--hover)] hover:text-ink',
                  h.depth === 3 ? 'pl-6 text-[12.8px]' : 'pl-3',
                ]}
              >{h.text}</a>
            ))
          }
          {toc.length === 0 && <span class="pl-3 text-[13px] text-muted">本文没有小标题</span>}
        </nav>
      </div>
      </aside>
    </div>
  </div>

  <nav class="mx-auto grid w-full max-w-[1140px] grid-cols-1 gap-4 px-5 pb-20 sm:grid-cols-2" aria-label="上下篇">
    {
      newer ? (
        <a href={urlOf(newer)} class="t-surface rounded-soft border border-line bg-surface p-5 transition-colors hover:border-line-strong hover:bg-[var(--hover)]">
          <span class="mb-1.5 block text-[11px] tracking-[0.28em] text-muted">← 更新的一篇</span>
          <span class="text-[15px] text-ink">{newer.data.title}</span>
        </a>
      ) : <span></span>
    }
    {
      older ? (
        <a href={urlOf(older)} class="t-surface rounded-soft border border-line bg-surface p-5 transition-colors hover:border-line-strong hover:bg-[var(--hover)] sm:text-right">
          <span class="mb-1.5 block text-[11px] tracking-[0.28em] text-muted">更早的一篇 →</span>
          <span class="text-[15px] text-ink">{older.data.title}</span>
        </a>
      ) : <span></span>
    }
  </nav>

  <script>
    /* 阅读进度：只改 transform: scaleX()，不碰 width，避免触发布局 */
    (function () {
      var bar = document.getElementById('progressBar');
      if (!bar) return;
      var raf = 0;
      function update() {
        raf = 0;
        var h = document.documentElement.scrollHeight - window.innerHeight;
        var p = h > 0 ? window.scrollY / h : 0;
        bar.style.transform = 'scaleX(' + Math.min(1, Math.max(0, p)).toFixed(4) + ')';
      }
      window.addEventListener('scroll', function () {
        if (!raf) raf = requestAnimationFrame(update);
      }, { passive: true });
      window.addEventListener('resize', update);
      update();
    })();

    /**
     * 从搜索结果点进来时带 ?q=关键词
     * → 在正文里找第一处匹配，包上 <mark> 并滚到屏幕中央
     */
    (function () {
      var q = '';
      try { q = new URLSearchParams(location.search).get('q') || ''; } catch (e) { return; }
      q = q.trim();
      if (!q) return;

      var body = document.getElementById('postBody');
      if (!body) return;
      var needle = q.toLowerCase();

      var walker = document.createTreeWalker(body, NodeFilter.SHOW_TEXT, {
        acceptNode: function (n) {
          if (!n.nodeValue || !n.nodeValue.trim()) return NodeFilter.FILTER_REJECT;
          var p = n.parentNode;
          if (!p) return NodeFilter.FILTER_REJECT;
          var tag = p.nodeName;
          if (tag === 'SCRIPT' || tag === 'STYLE' || tag === 'MARK') return NodeFilter.FILTER_REJECT;
          return NodeFilter.FILTER_ACCEPT;
        }
      });

      var node, text = null, idx = -1;
      while ((node = walker.nextNode())) {
        var i = node.nodeValue.toLowerCase().indexOf(needle);
        if (i >= 0) { text = node; idx = i; break; }
      }
      if (!text) return;

      var mark = null;
      try {
        var range = document.createRange();
        range.setStart(text, idx);
        range.setEnd(text, idx + needle.length);
        mark = document.createElement('mark');
        mark.className = 'find-hit';
        range.surroundContents(mark);
      } catch (e) {
        // 匹配跨越多个元素时 surroundContents 会抛错，退化成只滚动不包裹
        mark = null;
      }

      var target = mark || text.parentNode;
      if (!target) return;

      // 等两帧，让字体与布局稳定后再算位置，否则会滚偏
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          try {
            target.scrollIntoView({ block: 'center', behavior: 'smooth' });
          } catch (e) {
            target.scrollIntoView();
          }
          // 地址栏里的 ?q= 用完就清掉，避免刷新时反复定位
          try {
            var u = new URL(location.href);
            u.searchParams.delete('q');
            history.replaceState(null, '', u.pathname + u.search + u.hash);
          } catch (e) {}
        });
      });
    })();

    /**
     * 正文宽度可拖拽。
     * 容器是居中的，所以拖右边缘 1px 实际改变 2px 宽度。
     * 宽度存 localStorage，双击手柄复位。
     */
    (function () {
      var wrap = document.getElementById('articleWrap');
      var grip = document.getElementById('articleResizer');
      if (!wrap || !grip) return;

      var MIN = 760, MAX = 2000, KEY = 'yuuu-article-w';
      try {
        var saved = Number(localStorage.getItem(KEY) || 0);
        if (saved >= MIN && saved <= MAX) wrap.style.setProperty('--article-w', saved + 'px');
      } catch (e) {}

      var dragging = false, startX = 0, startW = 0;

      grip.addEventListener('pointerdown', function (e) {
        dragging = true;
        startX = e.clientX;
        startW = wrap.getBoundingClientRect().width;
        grip.classList.add('is-dragging');
        try { grip.setPointerCapture(e.pointerId); } catch (err) {}
        e.preventDefault();
      });

      grip.addEventListener('pointermove', function (e) {
        if (!dragging) return;
        var w = Math.round(startW + (e.clientX - startX) * 2);
        wrap.style.setProperty('--article-w', Math.max(MIN, Math.min(MAX, w)) + 'px');
      });

      function end() {
        if (!dragging) return;
        dragging = false;
        grip.classList.remove('is-dragging');
        try {
          localStorage.setItem(KEY, String(Math.round(wrap.getBoundingClientRect().width)));
        } catch (e) {}
      }
      grip.addEventListener('pointerup', end);
      grip.addEventListener('pointercancel', end);

      grip.addEventListener('dblclick', function () {
        wrap.style.removeProperty('--article-w');
        try { localStorage.removeItem(KEY); } catch (e) {}
      });
    })();

    /* 复制链接 */
    (function () {
      var btn = document.getElementById('copyLink');
      if (!btn) return;
      btn.addEventListener('click', function () {
        var url = location.href;
        function ok() {
          btn.textContent = '已复制 ✓';
          setTimeout(function () { btn.textContent = '复制本文链接'; }, 1600);
        }
        function fallback() {
          var ta = document.createElement('textarea');
          ta.value = url; ta.style.position = 'fixed'; ta.style.opacity = '0';
          document.body.appendChild(ta); ta.select();
          try { document.execCommand('copy'); ok(); } catch (e) {}
          document.body.removeChild(ta);
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(url).then(ok, fallback);
        } else fallback();
      });
    })();

    /* 目录高亮 */
    (function () {
      var nav = document.getElementById('tocNav');
      if (!nav) return;
      var links = [].slice.call(nav.querySelectorAll('a'));
      if (!links.length) return;
      var heads = links.map(function (a) { return document.getElementById(a.getAttribute('href').slice(1)); });
      var raf = 0;
      function update() {
        raf = 0;
        var y = window.scrollY + 130, cur = 0;
        heads.forEach(function (h, i) { if (h && h.offsetTop <= y) cur = i; });
        links.forEach(function (a, i) { a.classList.toggle('is-on', i === cur); });
      }
      window.addEventListener('scroll', function () {
        if (!raf) raf = requestAnimationFrame(update);
      }, { passive: true });
      update();
    })();
  </script>

</BaseLayout>

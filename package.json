{
  "name": "yuuu-blog-v2",
  "type": "module",
  "version": "2.4.3",
  "private": true,
  "description": "yuuu - Fontaine blue personal blog. Astro 7 + Tailwind 4 + Pagefind, deployed on Cloudflare Pages.",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5",
    "pnpm": ">=7.1.0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "astro dev",
    "serve": "npm run build && npm run audit && astro preview",
    "build": "astro build && pagefind --site dist",
    "build:only": "astro build",
    "index": "pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "verify": "node tools/verify.mjs",
    "audit": "node tools/audit-dist.mjs",
    "og": "node tools/make-og.mjs",
    "deploy": "npm run build && npx wrangler pages deploy dist",
    "domain": "node tools/set-domain.mjs",
    "icons": "node tools/make-icons.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/compiler": "^2.13.1",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3",
    "zod": "^4.6.5",
    "sharp": "^0.35.4"
  }
}

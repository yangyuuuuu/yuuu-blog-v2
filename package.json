{
  "name": "yuuu-blog-v2",
  "type": "module",
  "version": "2.6.0",
  "private": true,
  "description": "yuuu - Fontaine blue personal blog. Astro 7 + Tailwind 4 + Pagefind, deployed on Cloudflare Pages.",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5",
    "pnpm": ">=7.1.0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "astro dev",
    "serve": "npm run build && npm run audit && astro preview",
    "build": "astro build && node tools/make-private-manifest.mjs && pagefind --site dist",
    "build:only": "astro build",
    "index": "pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "verify": "node tools/verify.mjs",
    "audit": "node tools/audit-dist.mjs",
    "smoke": "node tools/smoke-search.mjs",
    "check:sort": "node tools/check-sort-link.mjs",
    "check:preview": "node tools/check-admin-preview.mjs",
    "check:mobile": "node tools/check-mobile-app.mjs",
    "check:worker": "node tools/check-worker-admin.mjs",
    "check:decap": "node tools/check-decap-extras.mjs",
    "check:all": "npm run verify && npm run smoke && npm run audit && npm run check:sort && npm run check:preview && npm run check:mobile && npm run check:worker && npm run check:decap",
    "new": "node tools/new-post.mjs",
    "posts": "explorer src\\content\\posts",
    "publish": "node tools/publish.mjs",
    "og": "node tools/make-og.mjs",
    "deploy": "node tools/deploy-pages.mjs",
    "deploy:dry": "node tools/deploy-pages.mjs --dry-run",
    "domain": "node tools/set-domain.mjs",
    "icons": "node tools/make-icons.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/compiler": "^2.13.1",
    "pagefind": "^1.5.2",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
